// UniNest — Student PG Accommodation Platform
// Database Schema: PostgreSQL + Prisma
// Money stored as integer paise (₹1 = 100 paise)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  LANDLORD
  ADMIN
  COLLEGE
  PROVIDER
}

enum Gender {
  MALE
  FEMALE
  ANY
}

enum BedStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  NOTICE_PERIOD
  MAINTENANCE_HOLD
  BLOCKED
}

enum BookingStatus {
  PENDING
  RESERVED
  VISIT_REQUESTED
  VISIT_CONFIRMED
  VISITED
  CONFIRMED
  KYC_PENDING
  AGREEMENT_PENDING
  VERIFICATION_PENDING
  MOVE_IN_READY
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum VisitStatus {
  REQUESTED
  COUNTER_PROPOSED
  ACCEPTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentType {
  RESERVATION_FEE
  RENT
  DEPOSIT
  ELECTRICITY
  SERVICE
  SUBSCRIPTION
  COMMISSION
}

enum KYCStatus {
  NOT_STARTED
  SUBMITTED
  IN_PROGRESS
  VERIFIED
  NEEDS_ACTION
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  NEEDS_RECHECK
  SUSPENDED
}

enum TenantVerificationStatus {
  READY
  SUBMITTED
  PROCESSING
  INFO_REQUIRED
  COMPLETED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REOPENED
}

enum DisputeStatus {
  OPEN
  EVIDENCE_SUBMITTED
  RESPONSE_PENDING
  UNDER_REVIEW
  RESOLVED
  ESCALATED
  CLOSED
}

enum DisputeCategory {
  PAYMENT
  DEPOSIT
  DAMAGE
  ELECTRICITY
  MAINTENANCE
  LISTING
  BOOKING
  AGREEMENT
  RULES
  SAFETY
  SERVICE
}

enum ServiceOrderStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EmergencyCategory {
  LIFE_SAFETY
  MEDICAL
  FIRE
  PROPERTY
  URGENT_MAINTENANCE
}

enum AgreementStatus {
  DRAFT
  SENT
  REVIEWED
  SIGNED
  ACTIVE
  EXPIRED
  TERMINATED
}

enum ReservationType {
  IMMEDIATE_VISIT
  ADVANCE_SESSION
}

enum HandshakeStatus {
  PENDING
  VISIT_OTP_VERIFIED
  MOVEIN_OTP_VERIFIED
  DISPUTE_FROZEN
  AUTO_RELEASED_GRACE
  REFUNDED_EMERGENCY
}

enum RentStatus {
  UPCOMING
  DUE
  PAID
  OVERDUE
  PARTIAL
  WAIVED
}

enum NotificationType {
  BOOKING
  RESERVATION
  VISIT
  MESSAGE
  KYC
  AGREEMENT
  VERIFICATION
  RENT
  ELECTRICITY
  MAINTENANCE
  EMERGENCY
  SERVICE
  DISPUTE
  MOVE_OUT
  VACANCY
  SYSTEM
}

// ─── USER & ROLE MODELS ─────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  role         UserRole
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student         Student?
  landlord        Landlord?
  college         College?
  serviceProvider ServiceProvider?

  bookings       Booking[]
  payments       Payment[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  reviews        Review[]
  disputes       Dispute[]       @relation("DisputeReporter")
  disputeResponses Dispute[]     @relation("DisputeRespondent")
  documents      Document[]
  referralsMade  Referral[]      @relation("Referrer")
  referralsReceived Referral[]   @relation("Referred")
  studentVisits  VisitAppointment[] @relation("VisitStudent")
  landlordVisits VisitAppointment[] @relation("VisitLandlord")
  sentMessages   Message[]       @relation("SentMessages")
  receivedMessages Message[]    @relation("ReceivedMessages")
  savedProperties SavedProperty[]

  @@index([role])
  @@index([email])
}

model Student {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender         String?
  collegeName    String?
  collegeId      String?
  college        College? @relation(fields: [collegeId], references: [id])
  enrollmentNo   String?
  course         String?
  year           Int?
  dob            DateTime?
  permanentAddr  String?
  currentAddr    String?
  emergencyName  String?
  emergencyPhone String?
  emergencyRel   String?
  moveInDate     DateTime?
  prefSharing    String?
  prefLocation   String?
  isInternational Boolean @default(false)
  passportNo     String?
  profileComplete Int     @default(85)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Roommate preferences
  sleepSchedule   String?
  studyHabits     String?
  cleanliness     Int?     @default(3) // 1-5
  noisePref       String?
  smokingPref     String?
  foodPref        String?
  socialPref      String?
  budgetMin       Int?     // paise
  budgetMax       Int?     // paise
  acPref          Boolean?

  tenancies       Tenancy[]
  kycRecords      KYCRecord[]
  waitlistEntries WaitlistEntry[]
  savedListings   SavedListing[]
  conditionReports MoveInConditionReport[]
  roommateRequests RoommateRequest[]

  @@index([collegeId])
}

model Landlord {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String?
  address     String?
  phone       String?
  panNo       String?
  gstNo       String?
  bankAccount String?
  ifscCode    String?
  responseRate Int     @default(98)
  avgResponseTime String @default("< 15 mins")
  profileComplete Int   @default(91)
  plan        String   @default("FREE") // FREE, PRO, BUSINESS, PORTFOLIO
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  properties  Property[]
  rewards     LandlordReward[]
}

model College {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeName     String
  logoUrl         String?
  address         String?
  city            String?
  state           String?
  contactPerson   String?
  contactEmail    String?
  contactPhone    String?
  housingCoordinator String?
  internationalContact String?
  partnershipStatus String @default("PARTNERED")
  website         String?
  hostelCapacity  Int      @default(0)
  totalStudents   Int      @default(0)
  latitude        Float?
  longitude       Float?
  profileComplete Int      @default(88)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  students        Student[]
  verifiedPGs     PropertyCollegeLink[]
  roommateRequests RoommateRequest[]
}

// ─── PROPERTY HIERARCHY ─────────────────────────────────────────────────────

model Property {
  id            String   @id @default(cuid())
  landlordId    String
  landlord      Landlord @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  name          String
  type          String   @default("PG") // PG, HOSTEL, FLAT, APARTMENT
  address       String
  locality      String?  @default("Model Town")
  city          String
  state         String
  pincode       String
  latitude      Float?
  longitude     Float?
  commuteTime   String?  // e.g. "5 mins auto / 15 mins walk"
  gender        Gender   @default(ANY)
  description   String?

  // Media
  images        String[] // JSON array of image URLs
  videoUrl      String?

  // Amenities (stored as JSON array of strings)
  amenities     String[]
  // Rules (stored as JSON array of strings)
  rules         String[]

  // Charges (paise)
  electricityRate Int    @default(800) // per unit in paise
  wifiAvailable   Boolean @default(false)
  wifiCharge      Int     @default(0) // monthly paise
  foodAvailable   Boolean @default(false)
  foodCharge      Int     @default(0) // monthly paise
  laundryAvailable Boolean @default(false)
  laundryCharge    Int     @default(0) // monthly paise
  maintenanceCharge Int    @default(0) // monthly paise
  parkingAvailable  Boolean @default(false)
  parkingCharge     Int     @default(0)

  // Verification
  verificationStatus VerificationStatus @default(DRAFT)
  verifiedAt         DateTime?
  verificationNotes  String?
  lastAvailabilityConfirm DateTime?

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rooms         Room[]
  listings      Listing[]
  bookings      Booking[]
  visitAppointments VisitAppointment[]
  maintenanceTickets MaintenanceTicket[]
  emergencyIncidents EmergencyIncident[]
  reviews       Review[]
  collegeLinks  PropertyCollegeLink[]
  electricityMeters ElectricityMeter[]
  savedProperties SavedProperty[]

  @@index([landlordId])
  @@index([city])
  @@index([locality])
  @@index([state])
  @@index([verificationStatus])
}

model PropertyCollegeLink {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  collegeId  String
  college    College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  distance   Float?   // km
  createdAt  DateTime @default(now())

  @@unique([propertyId, collegeId])
}

model Room {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomNumber  String
  floor       Int      @default(0)
  sharing     Int      @default(2) // number of beds
  hasAC       Boolean  @default(false)
  hasCooler   Boolean  @default(false)
  hasAttBath  Boolean  @default(false)
  rent        Int      // per bed per month in paise
  deposit     Int      // per bed in paise
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  beds        Bed[]

  @@index([propertyId])
}

model Bed {
  id         String    @id @default(cuid())
  roomId     String
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  label      String    // "A", "B", "C"
  status     BedStatus @default(AVAILABLE)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenancies       Tenancy[]
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]

  @@index([roomId])
  @@index([status])
}

model Listing {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isActive    Boolean  @default(true)
  lastRefreshed DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
  @@index([isActive])
}

model SavedListing {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  propertyId String
  createdAt  DateTime @default(now())

  @@unique([studentId, propertyId])
}

// ─── BOOKING & TENANCY ──────────────────────────────────────────────────────

model Booking {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  propertyId    String
  property      Property      @relation(fields: [propertyId], references: [id])
  bedId         String
  bed           Bed           @relation(fields: [bedId], references: [id])
  status        BookingStatus @default(PENDING)
  reservationFee Int          @default(39900) // ₹399 in paise
  moveInDate    DateTime?
  expiresAt     DateTime?
  notes         String?

  // ─── ESCROW HANDSHAKE FIELDS ─────────────────
  reservationType    ReservationType  @default(IMMEDIATE_VISIT)
  visitOtp           String?          // 4-digit numeric code for visit verification
  visitOtpExpiresAt  DateTime?        // When the visit OTP expires (72h from creation)
  visitVerifiedAt    DateTime?        // When visit OTP was verified
  moveInOtp          String?          // 6-digit handshake PIN for move-in
  moveInVerifiedAt   DateTime?        // When move-in OTP was verified
  handshakeStatus    HandshakeStatus  @default(PENDING)
  postVisitDecision  String?          // 'ACCEPTED' | 'REJECTED' | 'EMERGENCY_CANCEL'
  
  // Timing & Buffer Tracking
  agreedMoveInDate   DateTime?        // The official scheduled move-in date
  delayedMoveInDate  DateTime?        // If student declared late arrival
  graceWindowEndsAt  DateTime?        // MoveInDate + 7 Days auto-release
  emergencyReason    String?          // Reason for emergency cancellation
  emergencyWaiverCount Int            @default(0) // Track waivers used this semester
  vacancyCompAmount  Int?             // in paise, paid to landlord on forfeit
  
  // Escrow financial tracking
  escrowAmount       Int?             // Total amount held in escrow (paise)
  escrowReleasedAt   DateTime?        // When escrow was released to landlord
  advanceTokenAmount Int?             // For advance bookings: 15% holding token (paise)
  visitRejectCount   Int              @default(0) // Fair-use: track free visit rejections

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenancy       Tenancy?
  agreement     Agreement?
  visits        VisitAppointment[]
  messages      Message[]

  @@index([userId])
  @@index([bedId])
  @@index([status])
}

model Tenancy {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id])
  bedId       String
  bed         Bed      @relation(fields: [bedId], references: [id])
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean  @default(true)
  noticePeriodStart DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rentRecords  RentRecord[]
  deposits     Deposit[]

  @@index([studentId])
  @@index([bedId])
  @@index([isActive])
}

model Agreement {
  id          String          @id @default(cuid())
  bookingId   String          @unique
  booking     Booking         @relation(fields: [bookingId], references: [id])
  templateType String         @default("11_MONTH")
  startDate   DateTime
  endDate     DateTime
  rent        Int             // paise
  deposit     Int             // paise
  noticePeriod Int            @default(30) // days
  terms       String?
  status      AgreementStatus @default(DRAFT)
  landlordSigned Boolean      @default(false)
  tenantSigned   Boolean      @default(false)
  signedAt    DateTime?
  documentUrl String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// ─── KYC & VERIFICATION ─────────────────────────────────────────────────────

model KYCRecord {
  id           String    @id @default(cuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id])
  status       KYCStatus @default(NOT_STARTED)
  documentType String?
  documentNo   String?
  documentUrl  String?
  photoUrl     String?
  verifiedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([studentId])
}

model TenantVerification {
  id            String                   @id @default(cuid())
  referenceNo   String                   @unique
  studentName   String
  studentPhone  String?
  permanentAddr String?
  currentAddr   String?
  landlordName  String?
  propertyAddr  String?
  status        TenantVerificationStatus @default(READY)
  submittedAt   DateTime?
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
}

// ─── PAYMENTS & RENT ─────────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  amount        Int           // paise
  type          PaymentType
  status        PaymentStatus @default(PENDING)
  method        String?       // UPI, CARD, NETBANKING
  transactionId String?       @unique
  description   String?
  metadata      String?       // JSON for extra info
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
}

model RentRecord {
  id          String     @id @default(cuid())
  tenancyId   String
  tenancy     Tenancy    @relation(fields: [tenancyId], references: [id])
  month       Int        // 1-12
  year        Int
  amountDue   Int        // paise
  amountPaid  Int        @default(0)
  dueDate     DateTime
  paidDate    DateTime?
  status      RentStatus @default(UPCOMING)
  autoPayEnabled Boolean @default(false)
  paymentId   String?
  gracePeriodEnd DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([tenancyId, year, month])
  @@index([status])
}

model Deposit {
  id           String   @id @default(cuid())
  tenancyId    String
  tenancy      Tenancy  @relation(fields: [tenancyId], references: [id])
  amount       Int      // paise
  paidDate     DateTime?
  refundAmount Int?
  deductions   String?  // JSON array of deductions
  refundDate   DateTime?
  status       String   @default("HELD") // HELD, PARTIALLY_REFUNDED, REFUNDED, FORFEITED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenancyId])
}

// ─── ELECTRICITY ─────────────────────────────────────────────────────────────

model ElectricityMeter {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  meterNo    String
  location   String?  // "Room 201", "Common"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  readings   ElectricityReading[]

  @@index([propertyId])
}

model ElectricityReading {
  id         String           @id @default(cuid())
  meterId    String
  meter      ElectricityMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)
  reading    Int              // units
  readingDate DateTime
  photoUrl   String?
  createdAt  DateTime         @default(now())

  charges    UtilityCharge[]

  @@index([meterId])
}

model UtilityCharge {
  id          String             @id @default(cuid())
  readingId   String
  reading     ElectricityReading @relation(fields: [readingId], references: [id])
  units       Int
  rate        Int                // paise per unit
  amount      Int                // paise
  tenantName  String?
  isPaid      Boolean            @default(false)
  paidDate    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// ─── MAINTENANCE & EMERGENCY ─────────────────────────────────────────────────

model MaintenanceTicket {
  id           String              @id @default(cuid())
  propertyId   String
  property     Property            @relation(fields: [propertyId], references: [id])
  reportedBy   String              // user name
  reporterId   String?             // user id
  category     String              // PLUMBING, ELECTRICAL, FURNITURE, etc.
  description  String
  priority     MaintenancePriority @default(MEDIUM)
  status       MaintenanceStatus   @default(OPEN)
  photoUrls    String[]
  videoUrl     String?
  assignedTo   String?             // provider name
  providerId   String?
  estimatedCost Int?
  actualCost    Int?
  resolvedAt    DateTime?
  resolutionNote String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([propertyId])
  @@index([status])
}

model EmergencyIncident {
  id           String            @id @default(cuid())
  propertyId   String
  property     Property          @relation(fields: [propertyId], references: [id])
  reportedBy   String
  reporterId   String?
  category     EmergencyCategory
  description  String
  isDanger     Boolean           @default(false)
  providerName String?
  providerETA  String?
  status       String            @default("REPORTED") // REPORTED, RESPONDING, RESOLVED
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([propertyId])
}

// ─── DISPUTES ────────────────────────────────────────────────────────────────

model Dispute {
  id            String          @id @default(cuid())
  caseId        String          @unique // e.g. UN-DMG-00452
  reporterId    String
  reporter      User            @relation("DisputeReporter", fields: [reporterId], references: [id])
  respondentId  String?
  respondent    User?           @relation("DisputeRespondent", fields: [respondentId], references: [id])
  category      DisputeCategory
  title         String
  description   String
  status        DisputeStatus   @default(OPEN)
  resolution    String?
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  evidence      DisputeEvidence[]

  @@index([reporterId])
  @@index([status])
}

model DisputeEvidence {
  id         String   @id @default(cuid())
  disputeId  String
  dispute    Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  type       String   // PHOTO, DOCUMENT, AGREEMENT, PAYMENT_RECORD, METER_READING
  label      String
  url        String?
  content    String?
  uploadedBy String
  createdAt  DateTime @default(now())
}

// ─── REVIEWS ─────────────────────────────────────────────────────────────────

model Review {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  cleanliness Int      @default(3) // 1-5
  landlord    Int      @default(3)
  maintenance Int      @default(3)
  food        Int      @default(3)
  wifi        Int      @default(3)
  safety      Int      @default(3)
  accuracy    Int      @default(3)
  overall     Int      @default(3)
  comment     String?
  isVerifiedStay Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
}

// ─── SERVICES & PROVIDERS ────────────────────────────────────────────────────

model ServiceProvider {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  ownerName    String?
  phone        String?
  email        String?
  logoUrl      String?
  categories   String[] // service categories
  coverageArea String?
  coverageRadius Float  @default(10.0)
  workingHours String   @default("8:00 AM - 8:00 PM")
  emergencyAvailable Boolean @default(true)
  technicianCount Int   @default(5)
  rateCard     String?  // rate card notes or JSON
  payoutInfo   String?
  verificationDocs String[]
  isVerified   Boolean  @default(false)
  isAvailable  Boolean  @default(true)
  rating       Float    @default(0)
  totalJobs    Int      @default(0)
  profileComplete Int   @default(73)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  serviceOrders ServiceOrder[]
}

model ServiceCategory {
  id          String @id @default(cuid())
  name        String @unique
  icon        String?
  description String?
  parentId    String?
  isActive    Boolean @default(true)
}

model ServiceOrder {
  id            String             @id @default(cuid())
  providerId    String
  provider      ServiceProvider    @relation(fields: [providerId], references: [id])
  customerName  String
  customerId    String?
  propertyId    String?
  serviceName   String
  categoryName  String
  description   String?
  status        ServiceOrderStatus @default(REQUESTED)
  scheduledDate DateTime?
  completedDate DateTime?
  amount        Int                // paise
  commission    Int                @default(0) // paise (UniNest's cut)
  landlordShare Int                @default(0) // paise
  rating        Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  commissionRecord Commission?

  @@index([providerId])
  @@index([status])
}

model Commission {
  id             String       @id @default(cuid())
  serviceOrderId String       @unique
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  totalAmount    Int          // customer paid (paise)
  vendorAmount   Int          // vendor gets (paise)
  uninestAmount  Int          // uninest gets (paise)
  landlordAmount Int          // landlord reward (paise)
  createdAt      DateTime     @default(now())
}

model LandlordReward {
  id          String   @id @default(cuid())
  landlordId  String
  landlord    Landlord @relation(fields: [landlordId], references: [id])
  source      String   // "wifi", "laundry", "food", "referral", etc.
  amount      Int      // paise
  description String?
  month       Int
  year        Int
  createdAt   DateTime @default(now())

  @@index([landlordId])
}

// ─── MOVE-IN/OUT ─────────────────────────────────────────────────────────────

model MoveInConditionReport {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  propertyId   String
  roomNumber   String
  bedLabel     String
  items        String   // JSON: [{item, condition, photo}]
  photoUrls    String[]
  videoUrl     String?
  studentAccepted Boolean @default(false)
  landlordAccepted Boolean @default(false)
  acceptedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── WAITLIST ────────────────────────────────────────────────────────────────

model WaitlistEntry {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  bedId      String?
  bed        Bed?     @relation(fields: [bedId], references: [id])
  propertyId String?
  preferences String? // JSON
  isActive   Boolean  @default(true)
  notifiedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([studentId])
}

// ─── GUEST STAY ──────────────────────────────────────────────────────────────

model GuestStay {
  id          String   @id @default(cuid())
  propertyId  String
  studentName String
  guestName   String
  nights      Int
  pricePerNight Int    // paise
  totalAmount Int      // paise
  checkIn     DateTime
  checkOut    DateTime
  status      String   @default("BOOKED") // BOOKED, CHECKED_IN, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── REFERRALS ───────────────────────────────────────────────────────────────

model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  referrer       User     @relation("Referrer", fields: [referrerId], references: [id])
  referredId     String?
  referred       User?    @relation("Referred", fields: [referredId], references: [id])
  referralCode   String   @unique
  qualifyingEvent String? // "BOOKING_COMPLETED", "FIRST_RENT_PAID"
  rewardAmount   Int?     // paise
  status         String   @default("PENDING") // PENDING, QUALIFIED, REWARDED, EXPIRED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── NOTIFICATIONS ───────────────────────────────────────────────────────────

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  actionUrl  String?
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

// ─── DOCUMENTS ───────────────────────────────────────────────────────────────

model Document {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  type       String   // AGREEMENT, KYC, IDENTITY, RECEIPT, OTHER
  url        String
  isPrivate  Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ─── AUDIT LOG ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity     String   // Property, Booking, Payment, etc.
  entityId   String?
  oldValue   String?  // JSON
  newValue   String?  // JSON
  reason     String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

// ─── VISITS & MESSAGING ──────────────────────────────────────────────────────

model VisitAppointment {
  id              String      @id @default(cuid())
  appointmentNo  String      @unique // e.g. VIS-DEMO-1024
  bookingId       String?
  booking         Booking?    @relation(fields: [bookingId], references: [id])
  propertyId      String
  property        Property    @relation(fields: [propertyId], references: [id])
  studentId       String
  student         User        @relation("VisitStudent", fields: [studentId], references: [id])
  landlordId      String
  landlord        User        @relation("VisitLandlord", fields: [landlordId], references: [id])
  
  scheduledDate   DateTime
  timeSlot        String      // e.g. "4:00 PM – 5:00 PM"
  alternativeSlot String?     // e.g. "6:00 PM – 7:00 PM"
  visitorCount    Int         @default(1)
  notes           String?
  status          VisitStatus @default(REQUESTED)
  
  // Counter proposal fields
  counterDate     DateTime?
  counterSlot     String?
  counterReason   String?
  
  noShowReportedBy String?    // "STUDENT" or "LANDLORD"
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  messages        Message[]

  @@index([propertyId])
  @@index([studentId])
  @@index([landlordId])
  @@index([status])
}

model Message {
  id           String            @id @default(cuid())
  bookingId    String?
  booking      Booking?          @relation(fields: [bookingId], references: [id])
  visitId      String?
  visit        VisitAppointment? @relation(fields: [visitId], references: [id])
  senderId     String
  sender       User              @relation("SentMessages", fields: [senderId], references: [id])
  receiverId   String
  receiver     User              @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content      String
  isMasked     Boolean           @default(false)
  maskedReason String?
  isRead       Boolean           @default(false)
  createdAt    DateTime          @default(now())

  @@index([bookingId])
  @@index([visitId])
  @@index([senderId])
  @@index([receiverId])
}

model SavedProperty {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

// ─── ROOMMATE MARKETPLACE MODELS ───────────────────────────────────────────

enum RoommateRequestStatus {
  DRAFT
  ACTIVE
  PAUSED
  MATCHED
  CLOSED
  EXPIRED
}

enum RoommateMatchStatus {
  PENDING
  MATCHED
  DECLINED
  BLOCKED
  CLOSED
}

enum RoommateInterestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model RoommateRequest {
  id                         String                @id @default(cuid())
  studentId                  String
  student                    Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status                     RoommateRequestStatus @default(ACTIVE)
  name                       String?
  gender                     String?
  collegeName                String?
  collegeId                  String?
  college                    College?              @relation(fields: [collegeId], references: [id])
  course                     String?
  year                       Int?
  city                       String                @default("Ludhiana")
  locality                   String                @default("Ferozepur Road")
  radiusKm                   Float                 @default(3.0)
  budgetMin                  Int                   @default(5000)
  budgetMax                  Int                   @default(7000)
  roomType                   String                @default("Double Sharing")
  moveInDate                 DateTime?
  genderPreference           String?               @default("Same Gender")
  sleepSchedule              String?               @default("Night Owl")
  studySchedule              String?               @default("Late Night")
  noisePreference            String?               @default("Quiet Room")
  cleanlinessPreference      String?               @default("Very Neat")
  smokingPreference          String?               @default("Non-Smoker")
  foodPreference             String?               @default("Vegetarian")
  socialPreference           String?               @default("Balanced")
  visitorPreference          String?               @default("Weekend Only")
  petPreference              String?               @default("No Pets")
  acPreference               Boolean               @default(true)
  coolerPreference           Boolean               @default(false)
  heaterPreference           Boolean               @default(false)
  wifiPreference             Boolean               @default(true)
  foodProvidedPreference     Boolean               @default(true)
  attachedBathroomPreference Boolean               @default(true)
  furniturePreference        Boolean               @default(true)
  description                String?               @default("Focused on studies, clean, non-smoker and prefer a quiet room.")
  isVerified                 Boolean               @default(true)
  showFirstName              Boolean               @default(true)
  showCollege                Boolean               @default(true)
  showCourse                 Boolean               @default(true)
  showBudget                 Boolean               @default(true)
  showLifestyle              Boolean               @default(true)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  sentInterests              RoommateInterest[]    @relation("SentInterests")
  receivedInterests          RoommateInterest[]    @relation("ReceivedInterests")
  matchesAsA                 RoommateMatch[]       @relation("RequestAMatches")
  matchesAsB                 RoommateMatch[]       @relation("RequestBMatches")

  @@index([studentId])
  @@index([city, locality])
  @@index([status])
}

model RoommateInterest {
  id                String                 @id @default(cuid())
  senderRequestId   String
  senderRequest     RoommateRequest        @relation("SentInterests", fields: [senderRequestId], references: [id], onDelete: Cascade)
  receiverRequestId String
  receiverRequest   RoommateRequest        @relation("ReceivedInterests", fields: [receiverRequestId], references: [id], onDelete: Cascade)
  status            RoommateInterestStatus @default(PENDING)
  createdAt         DateTime               @default(now())

  @@unique([senderRequestId, receiverRequestId])
}

model RoommateMatch {
  id                 String              @id @default(cuid())
  requestAId         String
  requestA           RoommateRequest     @relation("RequestAMatches", fields: [requestAId], references: [id], onDelete: Cascade)
  requestBId         String
  requestB           RoommateRequest     @relation("RequestBMatches", fields: [requestBId], references: [id], onDelete: Cascade)
  studentAId         String
  studentBId         String
  compatibilityScore Float               @default(91.0)
  status             RoommateMatchStatus @default(MATCHED)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  messages           RoommateMessage[]

  @@index([requestAId, requestBId])
}

model RoommateMessage {
  id        String        @id @default(cuid())
  matchId   String
  match     RoommateMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String
  content   String
  isBlocked Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([matchId])
}

model RoommateReport {
  id                String   @id @default(cuid())
  reporterStudentId String
  reportedStudentId String
  reason            String
  details           String?
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())
}
